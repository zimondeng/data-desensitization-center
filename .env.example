# ==============================================================================
# 数据脱敏中心 (Data Desensitization Center) Docker Compose 环境变量示例
# 如需自定义配置，请复制本文件为 .env 并修改对应配置（.env 已被 .gitignore 忽略）
# ==============================================================================

# --- 服务端口与时区 ---
APP_PORT=18100
MYSQL_PORT=13306
# 建议保持 UTC，以与数据库 datetime / CURRENT_TIMESTAMP(3) 保持一致
TZ=UTC

# --- MySQL 8.0 数据库配置 ---
MYSQL_ROOT_PASSWORD=ds_root_password
# 默认初始化 SQL (docs/sql/01_schema.sql) 使用 kd_desensitize
MYSQL_DATABASE=kd_desensitize
# 注意：MYSQL_USER 不能设置为 root
MYSQL_USER=ds_user
MYSQL_PASSWORD=ds_password

# --- 构建期可选代理/镜像源（仅当直接构建无法访问外网时取消注释） ---
# HTTP_PROXY=http://host.docker.internal:10808
# HTTPS_PROXY=http://host.docker.internal:10808
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# --- 应用运行参数 (DS_* 前缀) ---
DS_APP_ENV=prod
DS_AUTO_INIT_DB=true
# 如需连接外部独立 MySQL，可取消注释并覆盖以下连接串：
# DS_DATABASE_URL=mysql+pymysql://ds_user:ds_password@mysql:3306/kd_desensitize?charset=utf8mb4

# --- 安全密钥配置（生产环境务必修改为高强度随机值） ---
DS_JWT_SECRET_KEY=ds-center-local-jwt-secret-key-at-least-32-bytes-long
DS_JWT_EXPIRE_SECONDS=28800
DS_MASTER_AES_KEY=ds_default_master_aes_256_key_32
DS_HASH_MASK_SALT=ds-center-irreversible-hash-salt-v1

# --- 默认管理员账号（仅在数据库首次初始化时写入） ---
DS_DEFAULT_ADMIN_USERNAME=admin
DS_DEFAULT_ADMIN_PASSWORD=Admin@123456
DS_DEFAULT_ADMIN_DISPLAY_NAME=系统管理员

# --- ONNX 推理与批处理任务配置 ---
DS_DEFAULT_ONNX_VARIANT=int8
DS_ONNX_POOL_WORKERS=2
DS_MAX_UPLOAD_BYTES=209715200
DS_DEFAULT_ARTIFACT_TTL_HOURS=72
DS_TTL_CLEANUP_INTERVAL_SECONDS=300
DS_TRUST_PROXY_HEADERS=false
