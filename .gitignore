# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Node / Web
node_modules/
web/dist/
web/.vite/

# Local environment & runtime data
.env
.env.*
