models/astrlink-guard/fp32/*
models/astrlink-guard/fp16/*

# Ephemeral uploads & masked output artifacts (keep .gitkeep)
data/tmp_uploads/*
!data/tmp_uploads/.gitkeep
data/artifacts/*
!data/artifacts/.gitkeep

# Local SQLite test files
*.db
*.sqlite3
